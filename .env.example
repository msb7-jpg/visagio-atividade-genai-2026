# ==============================================================================
# CineData Analytics — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Chaves de API de Provedores Cloud (Opcional se configurado diretamente na UI)
# As chaves inseridas na UI são salvas com criptografia Fernet (AES-128-CBC) no banco.
# ------------------------------------------------------------------------------

# Groq Cloud (Ultra-rápido, modelos Llama 3.3 e Qwen): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio (Modelos Gemini 2.5 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# OpenRouter (Modelos gratuitos com sufixo :free): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. Configurações Padrão de Inicialização de LLM
# ------------------------------------------------------------------------------
# Provedor inicial ativo: "local" | "groq" | "openrouter" | "google"
LLM_PROVIDER=local

# Modelo padrão (ex: Qwen3.5-4B-Q4_K_M, llama-3.3-70b-versatile, gemini-2.5-flash)
LLM_MODEL=Qwen3.5-4B-Q4_K_M

# URL base para provedor local (llamafile, LM Studio, Ollama, llama.cpp server)
# Exemplos:
# llamafile: http://localhost:8080/v1
# LM Studio: http://localhost:1234/v1
# Ollama:    http://localhost:11434/v1
LLM_BASE_URL=http://localhost:8080/v1

# Chave de API direta (caso não use os aliases específicos acima)
LLM_API_KEY=

# Timeout em segundos para chamadas ao modelo
LLM_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 3. Segurança e Criptografia do Banco de Configurações
# Utilizada para derivar a chave Fernet que cifra as API keys salvas no SQLite.
# ------------------------------------------------------------------------------
SECRET_KEY=cinedata-analytics-default-secret-key-change-me

# ------------------------------------------------------------------------------
# 4. Configuração de Embeddings e RAG Vetorial
# Modelo multilingual para busca semântica em sinopses e resenhas em português
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Hugging Face Settings (Opcional, para modelos protegidos ou controle de logs)
HF_TOKEN=your_huggingface_token_here
HF_HUB_DISABLE_PROGRESS_BARS=1
TQDM_DISABLE=1

# ------------------------------------------------------------------------------
# 5. Servidor FastAPI e Banco de Dados
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
DEBUG=True
LOG_LEVEL=INFO
